# Copy this file to .env and fill in real values.
# See ../docs/CONTRIBUTING.md#credentials-checklist for what each of these is
# and how to request it. Never commit .env — it's gitignored.
#
# Note: hardhat.config.cjs also loads ../.env.local (the root frontend env
# file) for VITE_ALCHEMY_API_KEY, so contracts work needs that file populated
# too, not just this one.

# Deployer/admin wallet — see ../docs/CONTRIBUTING.md#admin-deployer-wallet-custody
# before requesting this one. Used for every network (sepolia/baseSepolia/base).
PRIVATE_KEY=

# For `npx hardhat verify`
ETHERSCAN_API_KEY=

PAYMASTER_SIGNER_ADDRESS=
