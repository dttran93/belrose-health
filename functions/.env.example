# Copy this file to .env and fill in real values.
# See ../docs/CONTRIBUTING.md#credentials-checklist for what each of these is
# and how to request it. Never commit .env — it's gitignored.

# Read directly from a local .env file
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
APP_BASE_URL=https://belrosehealth.com/app

# --- Also read via process.env, but only needed for local emulator runs ---
# (production values for these come from Firebase's runtime environment, not
# a committed file)
ADMIN_WALLET_PRIVATE_KEY=
ALCHEMY_API_KEY=
RPC_URL=

# --- NOT set via this file at all ---
# These are bound with defineSecret()/the `secrets: [...]` handler option and
# live in Firebase Secret Manager. Set them with:
#   firebase functions:secrets:set <NAME>
# Listed here only so the full set of required secrets is discoverable in one
# place:
#   ANTHROPIC_KEY
#   OPENAI_API_KEY
#   RESEND_API_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   PAYMASTER_SIGNER_PRIVATE_KEY
