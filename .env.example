# Copy this file to .env.local and fill in real values.
# See docs/CONTRIBUTING.md#credentials-checklist for what each of these is
# and how to request it. Never commit .env.local — it's gitignored.

# Firebase — there are two databases, one for Dev and one for Prod
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATOR=false

# IDswyft — identity verification, currently unused in prod but still under
# evaluation. Only needed if you're working on src/features/IdentityVerification.
VITE_IDSWYFT_FRONTEND_URL=
VITE_IDSWYFT_URL=
VITE_IDSWYFT_API_KEY=

# Don't need to change between prod and dev
VITE_PIMLICO_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Admin Wallet Private Key — see docs/CONTRIBUTING.md#admin-deployer-wallet-custody
# before requesting this one. Not read by the frontend directly, but
# hardhat.config.cjs in /contracts loads it from this file.
PRIVATE_KEY=

# Sentry DSN — for error logging and monitoring. Optional for local dev.
VITE_SENTRY_DSN=

# --- Not read in src/, but hardhat.config.cjs (/contracts) reads this file
# for VITE_ALCHEMY_API_KEY to build the Base Sepolia RPC URL ---
VITE_ALCHEMY_API_KEY=
